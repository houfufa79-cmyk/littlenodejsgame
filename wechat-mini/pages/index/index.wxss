/* 减肥八法大作战 — 页面样式 */
.wrap {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: radial-gradient(circle at 50% 30%, #2c5364, #203a43, #0f2027);
}

.game-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* 坐标系采用逻辑 480×720，在 index.js 里根据窗口尺寸缩放 */
}

/* ---------- HUD ---------- */
.hud {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #fff;
  pointer-events: none;
}
.hud-item {
  background: rgba(0, 0, 0, .38);
  border-radius: 40rpx;
  padding: 10rpx 22rpx;
  backdrop-filter: blur(6px);
}
.hud-num {
  color: #ffd54f;
  font-weight: 700;
  margin: 0 2rpx;
}
.next-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.next-bubble {
  display: inline-block;
  background: #fff;
  border-radius: 50%;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 30rpx;
  color: #000;
}

/* ---------- Toast ---------- */
.toast {
  position: absolute;
  top: 24%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 44rpx;
  font-weight: 700;
  color: #ffd54f;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .6);
  opacity: 0;
  pointer-events: none;
  white-space: nowrap;
  transition: opacity .3s ease;
}
.toast.show {
  opacity: 1;
  animation: toastPulse 1.6s ease forwards;
}
@keyframes toastPulse {
  0%   { opacity: 0; transform: translateX(-50%) scale(.6); }
  15%  { opacity: 1; transform: translateX(-50%) scale(1.1); }
  25%  { transform: translateX(-50%) scale(1); }
  75%  { opacity: 1; }
  100% { opacity: 0; transform: translateX(-50%) translateY(-28rpx); }
}

/* ---------- Overlay ---------- */
.overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 25, 35, .82);
  backdrop-filter: blur(8px);
  z-index: 10;
}
.overlay-card {
  width: 85%;
  max-width: 640rpx;
  text-align: center;
  color: #fff;
  padding: 40rpx 30rpx;
}
.title {
  font-size: 56rpx;
  font-weight: 900;
  color: #ffd54f;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, .5);
  margin-bottom: 20rpx;
}
.title.over {
  color: #ff6b6b;
}
.sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, .85);
  margin-bottom: 30rpx;
}
.sub .hl {
  color: #ffd54f;
  font-weight: 700;
  font-size: 36rpx;
}
.sports {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  margin: 20rpx 0 30rpx;
}
.s-item {
  background: rgba(255, 255, 255, .12);
  border: 1rpx solid rgba(255, 255, 255, .25);
  border-radius: 40rpx;
  padding: 8rpx 20rpx;
  font-size: 26rpx;
}
.tips {
  font-size: 24rpx;
  color: rgba(255, 255, 255, .7);
  line-height: 2;
  margin-bottom: 40rpx;
}
.btn {
  display: inline-block;
  font-size: 36rpx;
  font-weight: 700;
  color: #4e2c00;
  background: linear-gradient(180deg, #ffd54f, #ffb300);
  border: none;
  border-radius: 999rpx;
  padding: 22rpx 80rpx;
  box-shadow: 0 10rpx 0 #c17900, 0 16rpx 40rpx rgba(0, 0, 0, .4);
  margin: 10rpx auto;
}
.btn::after {
  border: none;   /* 去除小程序按钮默认边框 */
}
.best {
  margin-top: 30rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, .75);
}
